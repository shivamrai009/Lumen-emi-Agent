# Lumen Finance EMI agent - copy to .env and fill in.
# Only one key is needed (Groq); speech-to-text and text-to-speech run locally.

# Groq free tier: the agent LLM, plus the eval borrower simulator and judge. Free key, no card:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# The free tier allows 8,000 tokens/minute per model (~4 agent turns). A rate-limited turn is
# re-sent at once to these models (comma-separated), which have their own allowance.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# low | medium | high for gpt-oss models; leave empty for models that reject it
GROQ_REASONING_EFFORT=low

# Local speech. Models download on first run (~1.6 GB Whisper, ~0.3 GB Kokoro).
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Hindi female voices hf_alpha / hf_beta speak English with an Indian accent too.
KOKORO_VOICE=hf_alpha

# Which borrower a browser call dials (see data/borrowers.json)
BORROWER_ID=B001

# Mock tool behaviour
MOCK_LOOKUP_DELAY_SECS=0.6
MOCK_LINK_DELAY_SECS=2.5
# never | first | always  (first = fail once, succeed on retry)
MOCK_LINK_FAILURE=never
FILLER_AFTER_SECS=1.2
USER_IDLE_SECS=7
# If the turn model thinks the caller hasn't finished, answer anyway after this much silence
TURN_MAX_SILENCE_SECS=1.5

# Evals: borrower simulator and judge. Both on qwen so they never compete with the agent's
# models (gpt-oss-120b, fallback gpt-oss-20b) for the per-model rate limit.
EVAL_SIMULATOR_MODEL=qwen/qwen3.8-27b
EVAL_JUDGE_MODEL=qwen/qwen3.8-27b
# groq | ollama  (ollama = local judge, no rate limits; needs `ollama serve`)
EVAL_JUDGE_PROVIDER=groq
